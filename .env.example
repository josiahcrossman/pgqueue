# Copy to .env and adjust as needed. cmd/* read these from the environment.

# Postgres connection string (pgx format).
DATABASE_URL=postgres://pgqueue:pgqueue@localhost:5432/pgqueue?sslmode=disable

# Number of worker goroutines that poll and process jobs.
WORKER_COUNT=4

# How long a worker sleeps after finding no work before polling again.
POLL_INTERVAL=500ms

# Maximum jobs a single claim pulls off the queue at once.
BATCH_SIZE=10

# How many times a job is attempted before it is marked permanently failed.
MAX_ATTEMPTS=5

# Base unit for exponential backoff: retry delay = BASE_BACKOFF * 2^(attempts-1).
BASE_BACKOFF=1s

# How old a job's lock (locked_at) must be before it's considered orphaned --
# i.e. the worker that claimed it died before finishing. Must comfortably
# exceed the slowest handler's expected runtime, or a still-running job could
# get reclaimed out from under a live worker. Unrelated to POLL_INTERVAL.
STALE_LOCK_TIMEOUT=5m
